# Copy this file to .env and fill in your values. Never commit .env.

# Google Gemini API key - create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (any model that supports structured JSON output)
GEMINI_MODEL=gemini-3.5-flash

# Comma separated models tried in order if the primary is overloaded (503) or unavailable (404)
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite

# Seconds to wait for a Gemini response
GEMINI_TIMEOUT_SECONDS=90

# Comma separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
